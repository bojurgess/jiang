{
    "name": "@bojurgess/jiang",
    "version": "1.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bojurgess/jiang.git"
    },
    "files": [
        "bundler/",
        "web/",
        "node/"
    ],
    "main": "./bundler/jiang.js",
    "types": "./bundler/jiang.d.ts",
    "exports": {
        ".": {
            "import": "./bundler/jiang.js",
            "types": "./bundler/jiang.d.ts"
        },
        "./bundler": {
            "import": "./bundler/jiang.js",
            "types": "./bundler/jiang.d.ts"
        },
        "./web": {
            "import": "./web/jiang.js",
            "types": "./web/jiang.d.ts"
        },
        "./node": {
            "require": "./node/jiang.js",
            "types": "./node/jiang.d.ts"
        }
    }
}
